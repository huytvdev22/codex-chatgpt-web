{
  "name": "codex-chatgpt-web",
  "version": "6.15.0",
  "private": true,
  "description": "A focused local Responses API bridge that runs Codex and OpenAI-compatible clients through Microsoft 365 Copilot.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huytvdev22/codex-chatgpt-web.git"
  },
  "homepage": "https://github.com/huytvdev22/codex-chatgpt-web#readme",
  "bugs": {
    "url": "https://github.com/huytvdev22/codex-chatgpt-web/issues"
  },
  "packageManager": "bun@1.4.0",
  "type": "module",
  "bin": {
    "codex-chatgpt-web": "./src/cli.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSES"
  ],
  "scripts": {
    "start": "bun run src/cli.ts serve",
    "setup": "bun run src/cli.ts setup",
    "doctor": "bun run src/cli.ts doctor",
    "test": "bun test ./tests",
    "audit": "bun audit",
    "check:circular": "node scripts/check-circular-deps.js",
    "check:architecture": "node scripts/check-circular-deps.js && bun test tests/m365-architecture-integrity.test.ts",
    "check-version": "bun run scripts/check-version.ts",
    "typecheck": "bun x --no-install --bun tsc --noEmit",
    "licenses": "bun run scripts/generate-third-party-notices.ts --include-launcher",
    "clean": "bun run scripts/clean.ts",
    "build": "bun run scripts/build-runtime-bundle.ts",
    "smoke": "bun run scripts/smoke-release.ts dist/runtime",
    "smoke:codex": "bun run scripts/smoke-codex-catalog.ts",
    "launcher": "bun run scripts/start-launcher.ts",
    "launcher:start": "bun run --cwd launcher build && bun run --cwd launcher start",
    "app": "bun run scripts/start-launcher.ts",
    "app:package": "bun run --cwd launcher package",
    "app:smoke": "bun run --cwd launcher smoke:package",
    "launcher:dev": "bun run --cwd launcher dev",
    "launcher:audit": "bun run --cwd launcher audit",
    "launcher:typecheck": "bun run --cwd launcher typecheck",
    "launcher:build": "bun run --cwd launcher build",
    "launcher:test": "bun run --cwd launcher test",
    "verify": "bun run scripts/verify.ts",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "chromium-bidi": "12.1.0",
    "fflate": "^0.8.2",
    "playwright-core": "^1.62.0",
    "tiktoken": "1.0.22",
    "toml-eslint-parser": "1.0.3",
    "turndown": "7.2.0",
    "turndown-plugin-gfm": "1.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/turndown": "5.0.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": "1.4.0"
  },
  "overrides": {
    "@hono/node-server": "2.1.5",
    "body-parser": "2.4.0",
    "fast-uri": "3.1.9",
    "hono": "4.13.12",
    "ip-address": "10.7.5",
    "proxy-addr": "2.0.8",
    "qs": "6.17.0",
    "zod": "4.6.7",
    "zod-to-json-schema": "3.25.1"
  },
  "keywords": [
    "codex",
    "m365-copilot",
    "responses-api",
    "playwright"
  ],
  "license": "MIT"
}
